# ════════════════════════════════════════════════════════════════════
# CONFIGURATION GMEP — variables d'environnement
# Sur Railway : configurez ces variables dans Settings → Variables
# En local    : copier ce fichier en .env puis remplir
# ════════════════════════════════════════════════════════════════════

# ─── Stripe (récupérer dans Dashboard Stripe → Developers → API keys) ───
STRIPE_SECRET_KEY=sk_live_REMPLACEZ_MOI
STRIPE_WEBHOOK_SECRET=whsec_REMPLACEZ_MOI

# ─── Price IDs Stripe (récupérer les price_xxx dans Dashboard Stripe → Products) ───
# Plans anciens
STRIPE_PRICE_JE_MONTHLY=price_REMPLACEZ_MOI
STRIPE_PRICE_JE_ANNUAL=price_REMPLACEZ_MOI
STRIPE_PRICE_DOMENICO_ANNUAL=price_REMPLACEZ_MOI
STRIPE_PRICE_RABATTEMENT_ANNUAL=price_REMPLACEZ_MOI
# Module HUMAIN Tier 3 — juin 2026
STRIPE_PRICE_HUMAIN_MONTHLY=price_REMPLACEZ_MOI
STRIPE_PRICE_HUMAIN_ANNUAL=price_REMPLACEZ_MOI
# Modélisation GEP — DLE & Loi sur l'Eau, ex Eaux pluviales v2.1 — juillet 2026
# ATTENTION : prix passé de 3 500 à 5 500 € HT/an. Les Price Stripe sont immuables :
# créer un NOUVEAU Price object à 5 500 € HT/an dans le Dashboard Stripe et repointer
# cette variable dessus (ne pas modifier l'ancien Price existant).
STRIPE_PRICE_EAUX_PLUVIALES_ANNUAL=price_REMPLACEZ_MOI
# Modélisation Essai de Porchet — juillet 2026 (550 € HT/an) — nouveau produit,
# créer un nouveau Price object Stripe à 550 € HT/an.
STRIPE_PRICE_PORCHET_ANNUAL=price_REMPLACEZ_MOI
# 3D_SSP — juillet 2026 (250 € HT/mois ou 2 400 € HT/an)
STRIPE_PRICE_SSP3D_MONTHLY=price_REMPLACEZ_MOI
STRIPE_PRICE_SSP3D_ANNUAL=price_REMPLACEZ_MOI

# ─── Stripe Tax (TVA automatique par pays) ───
ENABLE_STRIPE_TAX=true

# ─── URLs de redirection après paiement ───
SITE_URL=https://www.gmep-france.eu
SUCCESS_PATH=/tarifs.html?status=success&session={CHECKOUT_SESSION_ID}
CANCEL_PATH=/tarifs.html?status=cancel

# ─── CORS : domaine autorisé à appeler l'API ───
CORS_ORIGIN=https://www.gmep-france.eu

# ─── Port (Railway l'injecte automatiquement) ───
PORT=3001
